{
  "schema_version": 1,
  "distribution": "public",
  "id": "native_display",
  "title": "原生无边框显示",
  "category": "gameplay",
  "hosts": ["client"],
  "description": "为战斗选择渲染分辨率和 HUD 大小。画面可等比适配窗口，也可在本地应用匹配游戏图集的 PNG。",
  "presentation": "configurable",
  "mechanism": "复用客户端渲染和输入映射。战斗 HUD 独立缩放，本地图集保留原版裁剪范围、布局和点击区域。",
  "settings": [
    {
      "id": "resolution",
      "key": "Resolution",
      "label": "无边框分辨率",
      "type": "choice",
      "default": "desktop",
      "options": ["desktop", "1080p", "1440p", "2160p"],
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart"
    },
    {
      "id": "hud_scale",
      "key": "HudScale",
      "label": "战斗 HUD 大小",
      "type": "choice",
      "default": "auto",
      "options": ["auto", "off", "125%", "150%"],
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart"
    }
  ]
}
